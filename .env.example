# Copy to .env and fill in. Never commit .env.
SOLANA_CLUSTER=mainnet-beta
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
HELIUS_GATEKEEPER_RPC_URL=https://beta.helius-rpc.com/?api-key=${HELIUS_API_KEY}
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
HELIUS_PARSE_TX_URL=https://mainnet.helius-rpc.com/v0/transactions/?api-key=${HELIUS_API_KEY}
HELIUS_TX_HISTORY_URL=https://mainnet.helius-rpc.com/v0/addresses/{address}/transactions?api-key=${HELIUS_API_KEY}
HELIUS_GRPC_URL_DEVNET=https://laserstream-devnet-ewr.helius-rpc.com
HELIUS_WS_URL_DEVNET=wss://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
HELIUS_RPC_URL_DEVNET=https://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
HELIUS_GRPC_URL=https://laserstream-mainnet-ewr.helius-rpc.com
HELIUS_GRPC_TOKEN=${HELIUS_API_KEY}
HELIUS_SENDER_URL=
WALLET_KEYPAIR_PATH=
